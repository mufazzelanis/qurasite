# ── Database (PostgreSQL) ────────────────────────────────
# Local:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/qurafood
# Neon / Supabase: paste the connection string they give you
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qurafood?schema=public"

# ── Admin auth ───────────────────────────────────────────
# Any long random string (32+ chars)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@qurafood.com"
ADMIN_PASSWORD="ChangeMe@123"

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Pixel ID, Conversion API token, GA4, GTM, TikTok and delivery
# charges are all edited live from Admin → Settings (stored in DB).
